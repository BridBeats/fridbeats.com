{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://frid-beats-r2-upload.fridbeats.workers.dev/seo/sitemap.xml" },
    { "source": "/feed.xml", "destination": "https://frid-beats-r2-upload.fridbeats.workers.dev/seo/feed.xml" },
    { "source": "/beat/:path*", "destination": "/index.html" },
    { "source": "/templates/:path*", "destination": "/index.html" },
    { "source": "/flp-remake/:path*", "destination": "/index.html" },
    { "source": "/template/:path*", "destination": "https://frid-beats-r2-upload.fridbeats.workers.dev/seo/template/:path*" },
    { "source": "/flp/:path*", "destination": "https://frid-beats-r2-upload.fridbeats.workers.dev/seo/flp/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(beat|templates|template|flp|flp-remake)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
